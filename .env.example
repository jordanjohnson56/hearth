# Hearth bootstrap configuration.
#
# This file holds ONLY what the process needs before it can start. Everything a
# human would configure (people, calendar sources, PIN, theme times, chores,
# point values, seasons) lives in the database under DATA_DIR, editable from the
# admin screen. Nothing personal belongs in this file.
#
# Copy to .env and edit. .env is gitignored and must stay that way.

# Port the dashboard listens on (4321 is taken by command-center on this box).
PORT=4400

# Where SQLite and uploaded avatars live. MUST be outside the repo tree.
# ./data is the bare-metal demo default only; it is gitignored so a fresh clone
# runs without leaking anything. Under Docker this is the in-container path and
# the real location is the host directory bound to it: see HEARTH_DATA_HOST in
# docker-compose.yml.
DATA_DIR=./data

# Drives all date math: due-today, Mon-Sun week boundaries, season boundaries.
# Getting this wrong silently corrupts the entire scoring core.
TZ=America/Chicago

LOG_LEVEL=info
