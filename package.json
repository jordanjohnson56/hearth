{
  "name": "hearth",
  "version": "0.0.0",
  "private": true,
  "description": "A kitchen dashboard: shared family calendar and gamified chore tracker.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/main.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node dist/server/seed.js",
    "seed:dev": "tsx --tsconfig tsconfig.server.json src/server/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
